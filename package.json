{
  "name": "ecommerce-inventory-backend",
  "version": "1.0.0",
  "description": "Haat: full-stack multi-seller e-commerce and inventory system (Express, MongoDB, Socket.IO, React)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "demo:concurrency": "node scripts/concurrencyDemo.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm run dev\" \"npm --prefix client run dev\"",
    "start:prod": "npm run build && npm start"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}